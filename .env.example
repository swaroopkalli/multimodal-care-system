# Copy to .env (git-ignored) and fill in. Never commit real values.

# ---- PostgreSQL (system of record; Supabase pooler or any PostgreSQL) -------------------
DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
# The wearable worker uses these; they default to the DB_* values above when unset.
# INGESTION_DB_HOST= INGESTION_DB_PORT= INGESTION_DB_NAME= INGESTION_DB_USER= INGESTION_DB_PASSWORD= INGESTION_DB_SSLMODE=

# ---- Auth ---------------------------------------------------------------------------------
# At least 32 random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ACCESS_TTL_HOURS=12

# ---- Flask --------------------------------------------------------------------------------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0

# ---- Ollama (host install, http://localhost:11434) ------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBED_DIMENSIONS=768
# Context window actually requested from Ollama, and the share of it the prompt may use (rest = reply).
OLLAMA_NUM_CTX=8192
OLLAMA_PROMPT_BUDGET_RATIO=0.8
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_RETRIES=2
CHAT_MAX_INPUT_CHARS=20000

# ---- Redis (docker compose; host port 6380 avoids a host Redis on 6379) ----------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_HOST_PORT=6380
WEARABLE_STREAM=wearable:events
WEARABLE_GROUP=processor

# ---- Neo4j (docker compose) -------------------------------------------------------------------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
GRAPH_SYNC_INTERVAL_SECONDS=5

# ---- Simulator ---------------------------------------------------------------------------------
SIMULATOR_PATIENT_IDS=1
SIMULATOR_INTERVAL_SECONDS=5
SIMULATOR_DEVICE_ID=sim-device-001
SIMULATOR_HEART_RATE_SCENARIO=normal

# ---- EWMA / anomaly settings (bump EWMA_CONFIG_VERSION whenever you change any of them) -------
EWMA_CONFIG_VERSION=1
EWMA_HR_TAU_SECONDS=60
EWMA_STEPS_TAU_SECONDS=300
EWMA_DAILY_ALPHA=0.2
EWMA_MAX_GAP_SECONDS=900
EWMA_OUTLIER_K=4.0
ANOMALY_MIN_HISTORY_DAYS=7
ANOMALY_Z_THRESHOLD=2.5

# ---- Guardrails ----------------------------------------------------------------------------------
GUARD_MAX_RETRIES=1
# Text shown when a patient message contains self-harm language. Provide your region's crisis line here.
# GUARD_CRISIS_MESSAGE=
